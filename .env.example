# NebulosaBot — environment template
# Copy to .env and fill values. Never commit .env.

# --- Discord ---
# Bot token (Discord Developer Portal → Bot → Token)
DISCORD_TOKEN=your_bot_token_here
# Client ID / Secret for dashboard OAuth2 (Discord Developer Portal → OAuth2)
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
# Optional: used by dashboard server to fetch guild info
DISCORD_BOT_TOKEN=your_bot_token_here

# --- Supabase (bot + dashboard) ---
# Project URL (Supabase Dashboard → Settings → API → Project URL)
SUPABASE_URL=https://your-project-id.supabase.co
# Service role / anon key (Dashboard → Settings → API → anon/service_role)
SUPABASE_KEY=your_service_role_or_anon_key_here
# Dashboard-specific keys (Next.js Supabase SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Optional: JWT/JWKS verification for service_role (bot/config.py)
SUPABASE_JWT_SECRET=your_jwt_secret_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/jwks
SUPABASE_JWKS_URI=https://your-project.supabase.co/auth/v1/jwks
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# --- Feature flags / runtime ---
# DB URL for live migration tooling (scripts/apply_staging_migration.py, live_catalog)
DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Set ENV=test to allow test-key sentinel in non-pytest contexts (bot/config.py)
ENV=development

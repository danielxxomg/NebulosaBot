# Gentleman Guardian Angel — NebulosaBot
# Provider: OpenCode Zen
# Model: Muse Spark 1.2 Contributor (commandcode/muse-spark-1.2-contributor via opencode)

PROVIDER="opencode:commandcode/muse-spark-1.2-contributor"

FILE_PATTERNS="*.py"
EXCLUDE_PATTERNS="__pycache__,*.pyc,.mypy_cache,.pytest_cache"
RULES_FILE="AGENTS.md"
STRICT_MODE="true"
TIMEOUT=1500

PR_BASE_BRANCH="master"
